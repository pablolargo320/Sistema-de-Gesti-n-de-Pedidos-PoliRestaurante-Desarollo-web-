
# ============================================================
# SISTEMA CRUD DE MESAS
# Proyecto en Python
# ============================================================
#
# Funciones principales:
# - Crear mesas
# - Listar mesas
# - Buscar mesa por ID
# - Buscar mesa por número
# - Actualizar mesas
# - Eliminar mesas
# - Cambiar estado de una mesa
# - Filtrar mesas por estado
# - Mostrar estadísticas
#
# No utiliza MySQL.
# La información se almacena temporalmente en memoria.
# ============================================================


# ============================================================
# VARIABLES GLOBALES
# ============================================================

mesas = []

siguiente_id = 1


# ============================================================
# DATOS DE PRUEBA
# ============================================================

def cargar_datos_iniciales():

    global siguiente_id

    datos = [
        (1, "Disponible"),
        (2, "Ocupada"),
        (3, "Disponible"),
        (4, "Reservada"),
        (5, "Disponible")
    ]

    for numero, estado in datos:

        mesa = {
            "id_mesa": siguiente_id,
            "numero": numero,
            "estado": estado
        }

        mesas.append(mesa)

        siguiente_id += 1


# ============================================================
# MOSTRAR ENCABEZADO
# ============================================================

def mostrar_encabezado(titulo):

    print("\n")
    print("=" * 55)
    print(titulo.center(55))
    print("=" * 55)


# ============================================================
# VALIDAR ESTADO
# ============================================================

def validar_estado():

    estados_validos = [
        "Disponible",
        "Ocupada",
        "Reservada"
    ]

    while True:

        print("\nEstados disponibles:")

        for estado in estados_validos:
            print("-", estado)

        estado = input("\nIngrese el estado: ").strip().capitalize()

        if estado in estados_validos:

            return estado

        print("\nERROR: El estado ingresado no es válido.")


# ============================================================
# VALIDAR NÚMERO DE MESA
# ============================================================

def validar_numero_mesa():

    while True:

        try:

            numero = int(
                input("Ingrese el número de la mesa: ")
            )

            if numero <= 0:

                print("El número debe ser mayor que 0.")

                continue

            # Verificar si ya existe
            for mesa in mesas:

                if mesa["numero"] == numero:

                    print(
                        "ERROR: Ya existe una mesa con ese número."
                    )

                    break

            else:

                return numero

        except ValueError:

            print("ERROR: Debe ingresar un número entero.")


# ============================================================
# BUSCAR MESA INTERNAMENTE
# ============================================================

def obtener_mesa_por_id(id_mesa):

    for mesa in mesas:

        if mesa["id_mesa"] == id_mesa:

            return mesa

    return None


# ============================================================
# CREATE - CREAR MESA
# ============================================================

def crear_mesa():

    global siguiente_id

    mostrar_encabezado("CREAR NUEVA MESA")

    numero = validar_numero_mesa()

    estado = validar_estado()

    nueva_mesa = {
        "id_mesa": siguiente_id,
        "numero": numero,
        "estado": estado
    }

    mesas.append(nueva_mesa)

    print("\n" + "-" * 55)
    print("MESA CREADA CORRECTAMENTE")
    print("-" * 55)

    print("ID:", siguiente_id)
    print("Número:", numero)
    print("Estado:", estado)

    siguiente_id += 1


# ============================================================
# READ - LISTAR TODAS LAS MESAS
# ============================================================

def listar_mesas():

    mostrar_encabezado("LISTADO DE MESAS")

    if len(mesas) == 0:

        print("No hay mesas registradas.")

        return

    print(
        f"{'ID':<10}"
        f"{'NÚMERO':<15}"
        f"{'ESTADO':<20}"
    )

    print("-" * 45)

    for mesa in mesas:

        print(
            f"{mesa['id_mesa']:<10}"
            f"{mesa['numero']:<15}"
            f"{mesa['estado']:<20}"
        )

    print("-" * 45)

    print("Total de mesas:", len(mesas))


# ============================================================
# READ - BUSCAR POR ID
# ============================================================

def buscar_mesa_id():

    mostrar_encabezado("BUSCAR MESA POR ID")

    try:

        id_mesa = int(
            input("Ingrese el ID de la mesa: ")
        )

    except ValueError:

        print("ERROR: El ID debe ser un número.")

        return

    mesa = obtener_mesa_por_id(id_mesa)

    if mesa:

        print("\nMesa encontrada")
        print("-" * 35)
        print("ID:", mesa["id_mesa"])
        print("Número:", mesa["numero"])
        print("Estado:", mesa["estado"])

    else:

        print("\nNo existe una mesa con ese ID.")


# ============================================================
# READ - BUSCAR POR NÚMERO
# ============================================================

def buscar_mesa_numero():

    mostrar_encabezado("BUSCAR MESA POR NÚMERO")

    try:

        numero = int(
            input("Ingrese el número de la mesa: ")
        )

    except ValueError:

        print("ERROR: Debe ingresar un número.")

        return

    for mesa in mesas:

        if mesa["numero"] == numero:

            print("\nMesa encontrada")
            print("-" * 35)
            print("ID:", mesa["id_mesa"])
            print("Número:", mesa["numero"])
            print("Estado:", mesa["estado"])

            return

    print("\nNo existe una mesa con ese número.")


# ============================================================
# UPDATE - ACTUALIZAR MESA
# ============================================================

def actualizar_mesa():

    mostrar_encabezado("ACTUALIZAR MESA")

    try:

        id_mesa = int(
            input("Ingrese el ID de la mesa: ")
        )

    except ValueError:

        print("ERROR: El ID debe ser un número.")

        return

    mesa = obtener_mesa_por_id(id_mesa)

    if mesa is None:

        print("\nNo existe una mesa con ese ID.")

        return

    print("\nInformación actual")
    print("Número:", mesa["numero"])
    print("Estado:", mesa["estado"])

    print("\nIngrese la nueva información.")

    # Número nuevo
    while True:

        try:

            nuevo_numero = int(
                input("Nuevo número de mesa: ")
            )

            if nuevo_numero <= 0:

                print("El número debe ser mayor que 0.")

                continue

            # Verificar duplicados
            numero_valido = True

            for otra_mesa in mesas:

                if (
                    otra_mesa["numero"] == nuevo_numero
                    and otra_mesa["id_mesa"] != id_mesa
                ):

                    numero_valido = False

                    break

            if not numero_valido:

                print(
                    "ERROR: Ese número ya pertenece a otra mesa."
                )

                continue

            break

        except ValueError:

            print("ERROR: Debe ingresar un número entero.")

    nuevo_estado = validar_estado()

    mesa["numero"] = nuevo_numero
    mesa["estado"] = nuevo_estado

    print("\nMESA ACTUALIZADA CORRECTAMENTE")

    print("ID:", mesa["id_mesa"])
    print("Nuevo número:", mesa["numero"])
    print("Nuevo estado:", mesa["estado"])


# ============================================================
# UPDATE - CAMBIAR SOLO EL ESTADO
# ============================================================

def cambiar_estado():

    mostrar_encabezado("CAMBIAR ESTADO DE MESA")

    try:

        id_mesa = int(
            input("Ingrese el ID de la mesa: ")
        )

    except ValueError:

        print("ERROR: El ID debe ser un número.")

        return

    mesa = obtener_mesa_por_id(id_mesa)

    if mesa is None:

        print("\nNo existe una mesa con ese ID.")

        return

    print("\nEstado actual:", mesa["estado"])

    nuevo_estado = validar_estado()

    mesa["estado"] = nuevo_estado

    print("\nEstado actualizado correctamente.")
    print("Nuevo estado:", nuevo_estado)


# ============================================================
# DELETE - ELIMINAR MESA
# ============================================================

def eliminar_mesa():

    mostrar_encabezado("ELIMINAR MESA")

    try:

        id_mesa = int(
            input("Ingrese el ID de la mesa: ")
        )

    except ValueError:

        print("ERROR: El ID debe ser un número.")

        return

    mesa = obtener_mesa_por_id(id_mesa)

    if mesa is None:

        print("\nNo existe una mesa con ese ID.")

        return

    print("\nMesa seleccionada:")
    print("ID:", mesa["id_mesa"])
    print("Número:", mesa["numero"])
    print("Estado:", mesa["estado"])

    confirmacion = input(
        "\n¿Está seguro de eliminarla? (S/N): "
    ).strip().upper()

    if confirmacion == "S":

        mesas.remove(mesa)

        print("\nMESA ELIMINADA CORRECTAMENTE.")

    else:

        print("\nOperación cancelada.")


# ============================================================
# FILTRAR POR ESTADO
# ============================================================

def filtrar_por_estado():

    mostrar_encabezado("FILTRAR MESAS POR ESTADO")

    estado = validar_estado()

    resultados = []

    for mesa in mesas:

        if mesa["estado"] == estado:

            resultados.append(mesa)

    print("\nMesas con estado:", estado)

    print("-" * 45)

    if len(resultados) == 0:

        print("No hay mesas con ese estado.")

    else:

        for mesa in resultados:

            print(
                "ID:", mesa["id_mesa"],
                "| Número:", mesa["numero"],
                "| Estado:", mesa["estado"]
            )

    print("-" * 45)

    print("Cantidad encontrada:", len(resultados))


# ============================================================
# ESTADÍSTICAS
# ============================================================

def mostrar_estadisticas():

    mostrar_encabezado("ESTADÍSTICAS DE MESAS")

    total = len(mesas)

    disponibles = 0
    ocupadas = 0
    reservadas = 0

    for mesa in mesas:

        if mesa["estado"] == "Disponible":

            disponibles += 1

        elif mesa["estado"] == "Ocupada":

            ocupadas += 1

        elif mesa["estado"] == "Reservada":

            reservadas += 1

    print("Total de mesas:", total)
    print("Mesas disponibles:", disponibles)
    print("Mesas ocupadas:", ocupadas)
    print("Mesas reservadas:", reservadas)

    if total > 0:

        porcentaje_disponibles = (
            disponibles / total
        ) * 100

        print(
            "Disponibilidad:",
            round(porcentaje_disponibles, 2),
            "%"
        )


# ============================================================
# PAUSA
# ============================================================

def pausar():

    input("\nPresione ENTER para continuar...")


# ============================================================
# MENÚ PRINCIPAL
# ============================================================

def mostrar_menu():

    while True:

        mostrar_encabezado("SISTEMA DE GESTIÓN DE MESAS")

        print("1. Crear mesa")
        print("2. Listar todas las mesas")
        print("3. Buscar mesa por ID")
        print("4. Buscar mesa por número")
        print("5. Actualizar mesa")
        print("6. Cambiar estado")
        print("7. Eliminar mesa")
        print("8. Filtrar por estado")
        print("9. Ver estadísticas")
        print("10. Salir")

        print("=" * 55)

        opcion = input("Seleccione una opción: ").strip()

        if opcion == "1":

            crear_mesa()
            pausar()

        elif opcion == "2":

            listar_mesas()
            pausar()

        elif opcion == "3":

            buscar_mesa_id()
            pausar()

        elif opcion == "4":

            buscar_mesa_numero()
            pausar()

        elif opcion == "5":

            actualizar_mesa()
            pausar()

        elif opcion == "6":

            cambiar_estado()
            pausar()

        elif opcion == "7":

            eliminar_mesa()
            pausar()

        elif opcion == "8":

            filtrar_por_estado()
            pausar()

        elif opcion == "9":

            mostrar_estadisticas()
            pausar()

        elif opcion == "10":

            print("\n")
            print("=" * 55)
            print("Gracias por utilizar el sistema.")
            print("=" * 55)

            break

        else:

            print(
                "\nERROR: Seleccione una opción "
                "entre 1 y 10."
            )

            pausar()


# ============================================================
# INICIO DEL PROGRAMA
# ============================================================

print("\n")
print("=" * 55)
print("      SISTEMA CRUD DE GESTIÓN DE MESAS")
print("=" * 55)

print("\nCargando información inicial...")

cargar_datos_iniciales()

print("Datos cargados correctamente.")

print("\nEl sistema está listo para utilizarse.")

pausar()

mostrar_menu()

